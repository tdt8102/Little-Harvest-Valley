{
  "name": "little-harvest-valley",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "host": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/host.mjs",
    "host:share": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/host.mjs --share",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
